+/*
+ * net_send_timing_mark
+ *	Send IAC DO TIMING-MARK to the host.
+ *	Used by ELF to trigger z/OS token generation.
+ */
+void
+net_send_timing_mark(void)
+{
+    static unsigned char timing_mark[] = { IAC, DO, TELOPT_TM };
+    vtrace("SENT DO TIMING-MARK\n");
+    net_rawout(timing_mark, sizeof(timing_mark));
+}
