+/* ELF authentication states (private to this file) */
+typedef enum {
+    ELF_DISABLED = 0,      /* ELF not enabled */
+    ELF_WAITING_TOKEN,     /* ELF enabled, first screen seen, timer armed */
+    ELF_TIMING_MARK_SENT,  /* IAC DO TIMING-MARK sent, waiting for token */
+    ELF_SEND_USERID,       /* Token received, ready to send User ID token */
+    ELF_SEND_PASSWORD,     /* Ready to send Password token */
+    ELF_COMPLETE           /* Authentication complete */
+} elf_state_t;
+
+/*
+ * ELF authentication state (file-static for encapsulation).
+ * Defaults to ELF_DISABLED. Set to ELF_WAITING_TOKEN via elf_enable_processing()
+ * when valid ELF Application ID is configured.
+ */
+static elf_state_t elf_state = ELF_DISABLED;
+static ioid_t elf_timer_id = NULL_IOID;  /* timer for TIMING-MARK */
+
 /* Statics */
 
 typedef struct task {
@@ -3766,6 +3786,49 @@ task_connect_wait(void)
     }
 }
 
+/*
+ * Enable ELF automatic authentication processing.
+ * Called by elf_init() in glue.c when valid ELF Application ID is configured.
+ */
+void
+elf_enable_processing(void)
+{
+    elf_state = ELF_WAITING_TOKEN;
+}
+
+/*
+ * Timer callback: fires 10 seconds after first screen update.
+ * Sends IAC DO TIMING-MARK to trigger z/OS ELF token generation.
+ */
+static void
+elf_timing_mark_timeout(ioid_t id _is_unused)
+{
+    elf_timer_id = NULL_IOID;
+    if (elf_state == ELF_WAITING_TOKEN) {
+	vtrace("ELF: Sending IAC DO TIMING-MARK to trigger token generation\n");
+	net_send_timing_mark();
+	elf_state = ELF_TIMING_MARK_SENT;
+    }
+}
+
+/*
+ * Called by telnet_new_environ_recv() when the ELF token has been received
+ * from z/OS.  Advances state to ELF_SEND_USERID so that the next screen
+ * update triggers token transmission.
+ */
+void
+elf_token_notify(void)
+{
+    if (elf_state == ELF_WAITING_TOKEN || elf_state == ELF_TIMING_MARK_SENT) {
+	vtrace("ELF: Token received from z/OS, advancing to ELF_SEND_USERID\n");
+	if (elf_timer_id != NULL_IOID) {
+	    RemoveTimeOut(elf_timer_id);
+	    elf_timer_id = NULL_IOID;
+	}
+	elf_state = ELF_SEND_USERID;
+    }
+}
+
 /*
  * Callback from ctlr.c, to indicate that the host has changed the screen.
  */
@@ -3792,6 +3855,35 @@ task_host_output(void)
 	    }
 	}
     } FOREACH_LLIST_END(&taskq, q, taskq_t *);
+
+    /* ELF automatic token transmission */
+    if (elf_state != ELF_DISABLED && elf_state != ELF_COMPLETE &&
+	IN_3270 && CAN_PROCEED) {
+	switch (elf_state) {
+	case ELF_WAITING_TOKEN:
+	    /* First screen update: arm 10-second timer to send TIMING-MARK */
+	    if (elf_timer_id == NULL_IOID) {
+		vtrace("ELF: First screen update, arming 10s TIMING-MARK timer\n");
+		elf_timer_id = AddTimeOut(10000, elf_timing_mark_timeout);
+	    }
+	    break;
+	case ELF_TIMING_MARK_SENT:
+	    /* Waiting for token after TIMING-MARK â do nothing */
+	    break;
+	case ELF_SEND_USERID:
+	    send_elf_token(")USR.ID(");
+	    elf_state = ELF_SEND_PASSWORD;
+	    break;
+	case ELF_SEND_PASSWORD:
+	    send_elf_token(")PSS.WD(");
+	    elf_state = ELF_COMPLETE;
+	    break;
+	default:
+	    vtrace("ELF: Unexpected state %d\n", elf_state);
+	    elf_state = ELF_DISABLED;
+	    break;
+	}
+    }
 }
 
