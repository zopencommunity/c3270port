 class TestS3270Cookie(cti):
 
+    # Exercise both emulator and x3270if cookie reads, including a restart.
+    def test_s3270_x3270if_cookie_roundtrip(self):
+        for initial in (None, b'', b'Fixed-ASCII_cookie.123\n'):
+            with self.subTest(initial=initial), tempfile.TemporaryDirectory() as td:
+                path = os.path.join(td, 'cookie')
+                if initial is not None:
+                    with open(path, 'wb') as f:
+                        f.write(initial)
+                env = dict(os.environ, X3270COOKIEFILE=path, _BPXK_AUTOCVT='ON')
+                saved = None
+                for restart in range(2):
+                    port, ts = unused_port()
+                    s3270 = Popen(vgwrap(['s3270', '-scriptport', str(port),
+                        '-cookiefile', path]), stdin=DEVNULL, stdout=DEVNULL, env=env)
+                    self.children.append(s3270)
+                    ts.close()
+                    self.check_listen(port)
+                    with open(path, 'rb') as f:
+                        cookie = f.read()
+                    self.assertTrue(cookie)
+                    if saved is not None:
+                        self.assertEqual(saved, cookie)
+                    saved = cookie
+                    for command in ('Set(monoCase)', 'Quit()'):
+                        client = Popen(vgwrap(['x3270if', '-t', str(port), command]),
+                            stdout=PIPE, stderr=PIPE, env=env)
+                        self.children.append(client)
+                        stdout, stderr = client.communicate(timeout=5)
+                        self.assertEqual(0, client.returncode, stderr.decode())
+                    self.vgwait(s3270)
+
