diff --git a/include/cookiefile.h b/include/cookiefile.h
index 58876a2..e390938 100644
--- a/include/cookiefile.h
+++ b/include/cookiefile.h
@@ -30,4 +30,54 @@
  *              Cookie file operations.
  */
 
+#ifndef X3270_COOKIEFILE_H
+#define X3270_COOKIEFILE_H
+
+#include <errno.h>
+#include <fcntl.h>
+#include <unistd.h>
+#if defined(__MVS__) /*[*/
+# include <zos-io.h>
+#endif /*]*/
+
+/* Write protocol bytes; honor the encoding of existing tagged text files. */
+static inline int
+cookiefile_open(const char *filename, int flags, int mode)
+{
+    int fd = open(filename, flags, mode);
+
+#if defined(__MVS__) /*[*/
+    if (fd >= 0) {
+	int rc = __disableautocvt(fd);
+
+	if (rc >= 0 && (flags & O_ACCMODE) != O_RDONLY) {
+	    /* Generated cookies always contain ASCII protocol bytes. */
+	    rc = __setfdbinary(fd);
+	} else if (rc >= 0) {
+	    int tag = __getfdccsid(fd);
+	    unsigned short ccsid = tag & 0xffff;
+
+	    if (tag < 0) {
+		rc = -1;
+	    } else if ((tag & 0x10000) && ccsid != 819 && ccsid != 1208) {
+		/* Preserve tagged text, without changing the file's bytes or tag. */
+		struct f_cnvrt cvt = { SETCVTON, 819, (short)ccsid };
+
+		rc = fcntl(fd, F_CONTROL_CVT, &cvt);
+	    }
+	}
+	if (rc < 0) {
+	    int saved_errno = errno;
+
+	    close(fd);
+	    errno = saved_errno;
+	    return -1;
+	}
+    }
+#endif /*]*/
+    return fd;
+}
+
 bool cookiefile_init(void);
+
+#endif /* X3270_COOKIEFILE_H */
