+/**
+ * Process NEW-ENVIRON INFO subnegotiation received from server.
+ * This handles z/OS sending us the ELF token.
+ *
+ * @param[in] buf Buffer containing NEW-ENVIRON data (after IAC SB NEW-ENVIRON INFO)
+ * @param[in] len Length of buffer
+ */
+void
+telnet_new_environ_recv(unsigned char *buf, size_t len)
+{
+    unsigned char *cp = buf;
+    unsigned char *end = buf + len;
+    
+    vtrace("ELF: Processing NEW-ENVIRON INFO from server (length=%zu)\n", len);
+    
+    while (cp < end) {
+ unsigned char cmd = *cp++;
+ 
+ if (cmd == TELOBJ_VAR || cmd == TELOBJ_USERVAR) {
+     /* Extract variable name */
+     char varname[256];
+     size_t name_len = 0;
+     bool escaped = false;
+     
+     while (cp < end && *cp != TELOBJ_VALUE && *cp != IAC) {
+  if (*cp == TELOBJ_ESC) {
+      escaped = true;
+      cp++;
+      if (cp >= end) break;
+  }
+  if (name_len < sizeof(varname) - 1) {
+      varname[name_len++] = *cp;
+  }
+  cp++;
+  escaped = false;
+     }
+     varname[name_len] = '\0';
+     
+     /* Check for VALUE marker */
+     if (cp < end && *cp == TELOBJ_VALUE) {
+  cp++;  /* Skip VALUE marker */
+  
+  /* Extract value (may include binary token data) */
+  unsigned char *value_start = cp;
+  size_t value_len = 0;
+  
+  escaped = false;
+  while (cp < end && *cp != IAC) {
+      if (*cp == TELOBJ_ESC) {
+   escaped = true;
+   cp++;
+   if (cp >= end) break;
+      }
+      value_len++;
+      cp++;
+      escaped = false;
+  }
+  
+  /* Check if this is IBMAPPLID with token */
+  if (strcmp(varname, IBMAPPLID_VARNAME) == 0 && value_len > 0) {
+      /* z/OS is sending us the ELF token! */
+      vtrace("ELF: Received IBMAPPLID from z/OS (length=%zu)\n", value_len);
+      
+      /* Free any previous token */
+      if (elf_token_received != NULL) {
+   memset(elf_token_received, 0, elf_token_length);
+   Free(elf_token_received);
+      }
+      
+      /* Store the complete token (APPLID + encrypted data) */
+      elf_token_received = Malloc(value_len + 1);
+      memcpy(elf_token_received, value_start, value_len);
+      elf_token_received[value_len] = '\0';
+      elf_token_length = value_len;
+      
+      vtrace("ELF: Token stored successfully\n");
+      /* Notify task.c state machine that token is available */
+      elf_token_notify();
+      vtrace("ELF: Token hex dump:\n");
+      for (size_t i = 0; i < value_len; i++) {
+   if (i % 16 == 0) vtrace("ELF:   ");
+   vtrace("%02x ", (unsigned char)elf_token_received[i]);
+   if ((i + 1) % 16 == 0 || i == value_len - 1) vtrace("\n");
+      }
+      
+      /* Update the stored IBMAPPLID value to use the token */
+      environ_t *e = find_environ(&uservars, IBMAPPLID_VARNAME,
+    		strlen(IBMAPPLID_VARNAME));
+      if (e != NULL) {
+   /* Replace the value with the token */
+   size_t token_xlen = escaped_len((const char *)elf_token_received,
+    		       elf_token_length);
+   char *new_value = Malloc(token_xlen);
+   escaped_copy(new_value, (const char *)elf_token_received,
+        elf_token_length);
+   e->value = new_value;
+   e->value_len = token_xlen;
+   vtrace("ELF: Updated IBMAPPLID uservar with token\n");
+      }
+  }
+     }
+ }
+    }
+}
+
+/**
+ * Clean up ELF token storage on disconnect.
+ */
+void
+telnet_new_environ_cleanup(void)
+{
+    if (elf_token_received != NULL) {
+ vtrace("ELF: Clearing stored token\n");
+ memset(elf_token_received, 0, elf_token_length);
+ Free(elf_token_received);
+ elf_token_received = NULL;
+ elf_token_length = 0;
+    }
+    if (elf_target_applid != NULL) {
+ Free(elf_target_applid);
+ elf_target_applid = NULL;
+    }
+}
