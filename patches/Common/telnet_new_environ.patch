diff --git a/Common/telnet_new_environ.c b/Common/telnet_new_environ.c
index c3745aa..3c24c01 100644
--- a/Common/telnet_new_environ.c
+++ b/Common/telnet_new_environ.c
@@ -217,6 +217,16 @@ environ_init(void)
     environ_clear(&vars);
     environ_clear(&uservars);
 
+    /* Set IBMAPPLID. from appres, then from the environment. */
+    ibmapplid = appres.ibm_applid;
+    if (ibmapplid == NULL) {
+        ibmapplid = getenv(IBMAPPLID_VARNAME);
+    }
+    if (ibmapplid == NULL) {
+        ibmapplid = IBMAPPLID_NONE;
+    }
+    add_environ(&uservars, IBMAPPLID_VARNAME, ibmapplid);
+
     /* Set USER. Resource first, then from the environment. */
     user = host_user? host_user: (appres.user? appres.user: getenv("USER"));
     if (user == NULL) {
@@ -234,8 +244,13 @@ environ_init(void)
 	e->devname = devname_init(appres.devname);
     }
 
-    /* Set IBMELF. */
-    add_environ(&uservars, IBMELF_VARNAME, IBMELF_YES);
+    /* Set IBMELF only when Express Logon is requested. */
+    if (appres.express_logon || appres.ibm_applid != NULL) {
+        add_environ(&uservars, IBMELF_VARNAME, IBMELF_YES);
+        add_environ(&uservars, IBMAPPLID_VARNAME, ibmapplid);
+        vtrace("Express Logon: USER=%s IBMAPPLID=%s\n",
+            user ? user : "(none)", ibmapplid);
+    }
 
     /* Set IBMAPPLID, from the environment. */
     ibmapplid = getenv(IBMAPPLID_VARNAME);
@@ -648,6 +663,14 @@ toggle_string(const char *name, const char *value, unsigned flags, ia_t ia)
     return TU_SUCCESS;
 }
 
+/* Define the toggle function for expressLogon */
+static toggle_upcall_ret_t
+toggle_express_logon(const char *name, const char *value, unsigned flags, ia_t ia)
+{
+    /* Simple boolean toggle - no special handling needed beyond default behavior */
+    return TU_SUCCESS; 
+}
+
 /**
  * New-environment module registration.
  */
@@ -657,4 +680,6 @@ telnet_new_environ_register(void)
     /* Register the toggles. */
     register_extended_toggle(ResUser, toggle_string, NULL, NULL, (void **)&appres.user, XRM_STRING);
     register_extended_toggle(ResDevName, toggle_string, NULL, NULL, (void **)&appres.devname, XRM_STRING);
+    register_extended_toggle(ResIbmApplId, toggle_string, NULL, NULL, (void **)&appres.ibm_applid, XRM_STRING);
+    register_extended_toggle(ResExpressLogon, toggle_express_logon, NULL, NULL, (void **)&appres.express_logon, XRM_BOOLEAN);
 }
