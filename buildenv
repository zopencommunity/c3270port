zopen_check_results()
{
  dir="$1"
  pfx="$2"
  chk="$1/$2_check.log"

  if [ -f "$chk" ] && grep -q '^actualFailures:' "$chk"; then
    sed -n -e '/^actualFailures:/p' -e '/^totalTests:/p' \
      -e '/^expectedFailures:/p' -e '/^expectedTotalTests:/p' "$chk"
  else
    echo "actualFailures:1"
    echo "totalTests:0"
    echo "expectedFailures:0"
    echo "expectedTotalTests:1"
  fi
}

zopen_run_cookie_checks()
{
  python3 "${ZOPEN_ROOT}/testing/check-cookie-encoding.py" "$@"
}

